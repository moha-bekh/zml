load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@rules_zig//zig:defs.bzl", "zig_binary")

zig_binary(
    name = "portable_sm75",
    testonly = True,
    main = "portable_sm75.zig",
    deps = ["//zml"],
)

native_test(
    name = "portable_sm75_test",
    size = "medium",
    src = ":portable_sm75",
    tags = [
        "local",
        "manual",
        "requires-gpu",
    ],
    target_compatible_with = select({
        "//platforms:cuda.enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
